<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema id="fr.chartrandphilippe.Vinyle" path="/fr/chartrandphilippe/Vinyle/">
		<key type="b" name="maximize">
			<default>false</default>
			<summary>Maximize window on startup</summary>
		</key>
		<key type="i" name="width">
			<default>870</default>
			<summary>Default width of window</summary>
		</key>
		<key type="i" name="height">
			<default>650</default>
			<summary>Default height of window</summary>
		</key>
		<key type="b" name="manual-connection">
			<default>false</default>
			<summary>Connect to manually configured server</summary>
		</key>
		<key type="s" name="host">
			<default>""</default>
			<summary>Hostname or IP address</summary>
		</key>
		<key type="i" name="port">
			<range min="0" max="65535"/>
			<default>6600</default>
			<summary>Network port</summary>
		</key>
		<key type="s" name="password">
			<default>""</default>
			<summary>Password</summary>
		</key>
		<key type="b" name="show-bit-rate">
			<default>false</default>
			<summary>Show bit rate</summary>
		</key>
		<key type="b" name="send-notify">
			<default>false</default>
			<summary>Send notification on title change</summary>
		</key>
		<key type="b" name="stop-on-quit">
			<default>false</default>
			<summary>Stop playback on quit</summary>
		</key>
		<key type="b" name="mpris">
			<default>true</default>
			<summary>Provide MPRIS</summary>
		</key>
		<key type="s" name="default-browsing-mode">
			<choices>
				<choice value="albumartist" />
				<choice value="artist" />
				<choice value="composer" />
				<choice value="conductor" />
				<choice value="performer" />
				<choice value="album" />
				<choice value="genre" />
				<choice value="date" />
				<choice value="playlist" />
			</choices>
			<default>"artist"</default>
			<summary>To suit your definition of artist</summary>
		</key>
		<key type="i" name="albums-page-columns">
			<range min="3" max="8"/>
			<default>4</default>
			<summary>Max number of columns in the albums view</summary>
		</key>
		<key type="s" name="album-cover-size">
			<choices>
				<choice value="small" />
				<choice value="medium" />
				<choice value="large" />
				<choice value="no-cover" />
			</choices>
			<default>"medium"</default>
			<summary>Size of cover on album page</summary>
		</key>
		<key type="s" name="albums-order">
			<choices>
				<choice value="alphabetical" />
				<choice value="chronological" />
				<choice value="most-recent-first" />
				<choice value="as-is" />
			</choices>
			<default>"chronological"</default>
			<summary>Ordering of covers on the albums page</summary>
		</key>
		<key type="s" name="cover-cache-size">
			<choices>
				<choice value="200" />
				<choice value="400" />
				<choice value="800" />
				<choice value="1600" />
			</choices>
			<default>"800"</default>
			<summary>Size of cover cache</summary>
		</key>
		<key type="b" name="log-to-playlist">
			<default>false</default>
			<summary>Keep a history of played songs</summary>
		</key>
		<key type="i" name="max-number-of-albums">
			<range min="0" max="1000"/>
			<default>500</default>
			<summary>Maximum number of albums on the same page</summary>
		</key>
		<key type="i" name="max-number-of-playlist-items">
			<range min="0" max="2000"/>
			<default>1000</default>
			<summary>Maximum number of items from a playlist</summary>
		</key>
	</schema>
</schemalist>
